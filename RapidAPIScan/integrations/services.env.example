# Standard OpenTelemetry environment for ANY service (any language) reporting to RapidPulse.
# Works with opentelemetry-instrument (Python), the .NET / Java / Node auto-instrumentation agents,
# and the OpenTelemetry Collector. Nothing here is RapidPulse-specific except the header name.

OTEL_SERVICE_NAME=orders-api
OTEL_RESOURCE_ATTRIBUTES=service.namespace=my-application,deployment.environment.name=prod,container.name=orders-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://10.20.0.50:4400
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=x-pulse-key=change-me
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
OTEL_PYTHON_EXCLUDED_URLS=health,healthz,readyz,metrics
OTEL_TRACES_SAMPLER=parentbased_always_on

# Zero-code Python:
#   pip install opentelemetry-distro opentelemetry-exporter-otlp-proto-http
#   opentelemetry-bootstrap -a install
#   opentelemetry-instrument uvicorn app.main:app --host 0.0.0.0 --port 8000
